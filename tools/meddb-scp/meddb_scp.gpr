with "../../crates/meddb_common/meddb_common.gpr";
with "../../crates/meddb_scp/meddb_scp.gpr";

project Meddb_Scp_App is

   for Main use ("meddb_scp.adb");
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use "../../bin";
   for Create_Missing_Dirs use "True";

   package Builder is
      for Executable ("meddb_scp.adb") use "meddb-scp";
   end Builder;

   package Compiler is
      for Default_Switches ("Ada") use ("-g", "-O2", "-gnat2012", "-gnatwa");
   end Compiler;

end Meddb_Scp_App;
