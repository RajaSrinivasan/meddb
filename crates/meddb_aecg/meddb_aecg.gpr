with "../meddb_common/meddb_common.gpr";
with "../meddb_biosig/meddb_biosig.gpr";

project Meddb_Aecg is

   for Library_Name use "meddb_aecg";
   for Library_Kind use "static";
   for Library_Dir use "lib";
   for Source_Dirs use ("src", "src/c");
   for Object_Dir use "obj";
   for Create_Missing_Dirs use "True";
   for Languages use ("Ada", "C");

   package Compiler is
      for Default_Switches ("Ada") use ("-g", "-O2", "-gnat2012", "-gnatwa");
      for Default_Switches ("C") use
        ("-O2", "-fPIC", "-D_GNU_SOURCE", "-I/usr/include/libxml2");
   end Compiler;

   package Linker is
      for Linker_Options use ("-lxml2");
   end Linker;

end Meddb_Aecg;
