with "../../crates/meddb_common/meddb_common.gpr";
with "../../crates/meddb_aecg/meddb_aecg.gpr";

project Meddb_Aecg_App is

   for Main use ("meddb_aecg.adb");
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use "../../bin";
   for Create_Missing_Dirs use "True";

   package Builder is
      for Executable ("meddb_aecg.adb") use "meddb-aecg";
   end Builder;

   package Compiler is
      for Default_Switches ("Ada") use ("-g", "-O2", "-gnat2012", "-gnatwa");
   end Compiler;

end Meddb_Aecg_App;
